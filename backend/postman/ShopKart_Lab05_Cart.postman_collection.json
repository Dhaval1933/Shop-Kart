{
  "info": {
    "_postman_id": "shopkart-lab05-cart-collection",
    "name": "ShopKart Lab 05 — Shopping Cart APIs",
    "description": "Comprehensive Postman test collection for ShopKart Engineering Lab 05 Shopping Cart APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "6a9ec400eda8eb1f54723d02",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Setup - Login & Save Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "  pm.collectionVariables.set('token', jsonData.token);",
              "  console.log('Token stored in collection variable');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"dhaval_test_wishlist@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/customers/login",
          "host": ["{{baseUrl}}"],
          "path": ["customers", "login"]
        }
      }
    },
    {
      "name": "1. Add New Item to Cart (POST /cart/:productId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cart/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "{{productId}}"]
        },
        "description": "Adds product to current authenticated user's cart with quantity = 1."
      }
    },
    {
      "name": "2. Add Same Item Again (Increment Quantity to 2)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cart/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "{{productId}}"]
        },
        "description": "Calling again with already carted productId increments quantity to 2 without creating duplicate rows."
      }
    },
    {
      "name": "3. Get Cart (GET /cart -> populated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cart",
          "host": ["{{baseUrl}}"],
          "path": ["cart"]
        },
        "description": "Returns current user's populated cart with product details (name, price, stock, image) and quantities."
      }
    },
    {
      "name": "4. Update Quantity (PATCH /cart/:productId)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "{{productId}}"]
        },
        "description": "Updates quantity of specific product in cart."
      }
    },
    {
      "name": "5. Exceed Stock Limit (PATCH /cart/:productId -> 400)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 9999\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "{{productId}}"]
        },
        "description": "Requests quantity higher than product stock. Should return 400 Bad Request."
      }
    },
    {
      "name": "6. Remove Item from Cart (DELETE /cart/:productId)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cart/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "{{productId}}"]
        },
        "description": "Removes product item from current user's cart."
      }
    },
    {
      "name": "7. Unauthenticated Cart Request (GET /cart -> 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cart",
          "host": ["{{baseUrl}}"],
          "path": ["cart"]
        },
        "description": "Calling protected cart endpoints without a token returns 401 Unauthorized."
      }
    }
  ]
}
